{
  "author": "Liubomyr",
  "name": "WordBerry [2.0.0]",
  "short_name": "WordBerry",
  "version": "2.0.0",
  "browser_action": {
    "default_icon": "WordBerry-48.png",
    "default_popup": "extension_popup.html"
  },
  "web_accessible_resources": [
    "public/*"
  ],
  "background": {
    "persistent": true,
    "scripts": [
      "public/background_popup_script.bundle.js"
    ]
  },
  "externally_connectable": {
    "matches": ["http://localhost:8082/*"]
  },
  "content_scripts": [
    {
      "matches": [
        "\u003Call_urls>"
      ],
      "css": [
        "public/css/inject_launcher.css"
      ],
      "js": [
        "public/inject_launcher.bundle.js"
      ],
      "all_frames": false,
      "run_at": "document_idle"
    }
  ],
  "content_security_policy": "script-src 'self'; object-src 'self'",
  "description": "Translate easy with WordBerry. WordBerry is extension with help you find words in web site by your vocabulary",
  "icons": {
    "128": "WordBerry-128.png",
    "48": "WordBerry-48.png",
    "16": "WordBerry-16.png"
  },
  "manifest_version": 2,
  "permissions": [
    "storage",
    "cookies",
    "background",
    "identity",
    "tabs",
    "http://*/*",
    "https://*/*",
    "webNavigation"
  ],
  "update_url": "https://clients2.google.com/service/update2/crx"
}
